# Nexus backend env vars — all optional. Copy to .env (never commit .env).
# See README → "User accounts & authentication".

# Auth with Supabase: set the JWT secret to enable the web login wall and
# per-user data islands (NEXUS_HOME/users/<userID>/). Unset = legacy
# single-user mode.
NEXUS_SUPABASE_URL=
NEXUS_SUPABASE_JWT_SECRET=
# NEXUS_SUPABASE_JWT_AUD=authenticated

# Emails (comma-separated) allowed to claim the legacy single-user data once.
# NEXUS_ADMIN_EMAILS=

# CORS allow-list for the web dashboard (comma-separated origins).
# Unset = allow any origin (local development only).
# NEXUS_ALLOWED_ORIGINS=https://app.example.com
